#!/usr/bin/env bash
# Защитный хук: не даёт закоммитить личные данные (профили браузера, ключи, пароли, токены).
# Включается командой:  git config core.hooksPath .githooks  (export.sh делает это сам).
bad=0

NAMES='(^|/)(logins\.json|key[0-9]*\.db|cert[0-9]*\.db|cookies[^/]*|[^/]*\.sqlite|Login Data|Web Data|Local State|Cookies|id_rsa|id_ed25519|id_ecdsa|[^/]*\.pem|[^/]*\.key|\.env|\.netrc|\.zsh_history|\.bash_history)$|(^|/)(\.mozilla|\.ssh|\.gnupg|BraveSoftware|google-chrome|chromium|discord|Telegram)(/|$)'

while IFS= read -r f; do
  [[ -z $f ]] && continue
  if [[ $f =~ $NAMES ]]; then
    echo "ЗАБЛОКИРОВАНО: «$f» похож на личные данные (браузер, ключи, история)."
    bad=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if git diff --cached -U0 | grep -E '^\+' | grep -Eq \
  '(sk-[A-Za-z0-9_-]{20,}|BEGIN (RSA|OPENSSH|EC|PRIVATE) |ghp_[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|[Pp]assword *= *[^ ]+)'; then
  echo "ЗАБЛОКИРОВАНО: в изменениях есть то, что похоже на пароль, ключ или токен."
  bad=1
fi

if (( bad )); then
  echo "Убери это из коммита (git reset HEAD <файл>) и добавь в .gitignore."
  exit 1
fi
exit 0
